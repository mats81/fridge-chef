# Copy to .env.local (local dev) or into your Unraid container variables.
# Every key is optional — the app falls back to its 30 built-in recipes.

# Online recipe fallback — https://spoonacular.com/food-api
SPOONACULAR_API_KEY=

# AI recipe ideas from a local Ollama instance
OLLAMA_BASE_URL=http://192.168.1.164:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000

# Photo -> ingredients. Requires a vision model on the same Ollama host:
#   ollama pull llava:7b
# Leave empty to hide the camera button.
OLLAMA_VISION_MODEL=
OLLAMA_VISION_TIMEOUT_MS=120000

# Images for AI-generated recipes — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Where generated recipes are persisted (Docker sets this to /data)
DATA_DIR=
